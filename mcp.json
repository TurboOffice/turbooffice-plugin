{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "turbooffice": {
      "type": "streamable-http",
      "url": "https://turbooffice.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "work:read",
              "work:write",
              "agent:run",
              "cards:approve"
            ]
          }
        }
      }
    }
  }
}
